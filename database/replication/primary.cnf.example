# Apply only after host firewall and VLAN30 access review with C.
[mysqld]
server_id=1
log_bin=mysql-bin
gtid_mode=ON
enforce_gtid_consistency=ON
log_replica_updates=ON
sync_binlog=1
innodb_flush_log_at_trx_commit=1
binlog_expire_logs_seconds=604800
# Wildcard binding accommodates the manually assigned DB VIP.
# C MUST restrict non-DB interfaces and allowed source addresses on the host.
bind_address=0.0.0.0
require_secure_transport=ON
# Set verified CA/certificate/key paths for this host before deployment.
# ssl_ca=/etc/mysql/tls/ca.crt
# ssl_cert=/etc/mysql/tls/server.crt
# ssl_key=/etc/mysql/tls/server.key
