<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>


<!-- 게시판 파일 위변조 / 웹셸 탐지 -->
<group name="flask_board,syscheck,local,">

  <rule id="100221" level="8">
    <if_sid>550,553,554</if_sid>
    <field name="file" type="pcre2">(?i)(?:_7_board_test|wazuh-board)[\\/]templates</field>
    <description>게시판 화면 템플릿 파일 변경 - 위변조 의심</description>
    <mitre>
      <id>T1565.001</id>
    </mitre>
  </rule>

  <rule id="100220" level="12">
    <if_sid>100221</if_sid>
    <field name="file" type="pcre2">(?i)[.](php|jsp|jspx|asp|aspx|py|sh|exe|ps1)$</field>
    <description>게시판 웹 디렉터리에 실행형 파일 생성/변조 - 웹셸 의심</description>
    <mitre>
      <id>T1505.003</id>
    </mitre>
  </rule>

  <rule id="100222" level="10">
    <if_sid>553</if_sid>
    <field name="file" type="pcre2">(?i)(?:_7_board_test|wazuh-board)[\\/]templates[\\/].*[.](?:php|jsp|jspx|asp|aspx|py|sh|exe|ps1)$</field>
    <description>게시판 웹 디렉터리의 실행형 파일 삭제 - 흔적 제거 의심(확인 필요)</description>
    <mitre>
      <id>T1070.004</id>
    </mitre>
  </rule>

</group>


<!-- 웹앱 로그인 실패 / 브루트포스 -->
<group name="webapp,local,">

  <rule id="100210" level="5">
    <if_sid>1002</if_sid>
    <decoded_as>webapp-login</decoded_as>
    <match>login_failed</match>
    <description>연습 웹앱 로그인 실패</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100211" level="10" frequency="6" timeframe="120">
    <if_matched_sid>100210</if_matched_sid>
    <same_source_ip />
    <description>연습 웹앱 브루트포스 의심 (동일 IP 다수 실패)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

</group>

<!-- ================================================================
  Graylog EX-07 / ED-01 / EX-06 호스트 탐지 확장 (2026-10-22)
  기존 100001,100210,100211,100220,100221,100222 보존.
  조건: Linux Wazuh Agent의 auth / syslog / FIM 로그 수집 필요.
  아래는 탐지 알림용이며 실제 차단/권한 회수 기능은 수행하지 않음.
================================================================ -->

<!-- EX-07: 감사·인증 로그 및 보안 설정 파일 변조/삭제 (FIM) -->
<group name="graylog_ex07,syscheck,local,">
  <rule id="100230" level="10">
    <if_sid>550,553,554</if_sid>
    <field name="file" type="pcre2">^/var/log/(?:auth[.]log(?:[.].*)?|secure(?:[.].*)?|audit/audit[.]log(?:[.].*)?|syslog(?:[.].*)?|messages(?:[.].*)?)$</field>
    <description>EX-07: Linux security or audit log file changed (check rotation and maintenance).</description>
    <group>log_tampering_candidate,fim_monitoring,</group>
    <mitre><id>T1070.002</id></mitre>
  </rule>
  <rule id="100231" level="11">
    <if_sid>550,553,554</if_sid>
    <field name="file" type="pcre2">^/etc/(?:sudoers(?:[.]d/[^/]+)?|ssh/sshd_config|audit/(?:auditd[.]conf|rules[.]d/[^/]+))$</field>
    <description>EX-07: Privileged access or audit configuration modified.</description>
    <group>security_configuration_change,fim_monitoring,</group>
    <mitre><id>T1562.001</id></mitre>
  </rule>
</group>

<!-- ED-01: Linux 호스트의 특권 명령 및 계정 관리 (Flask RBAC와 별개) -->
<group name="graylog_ed01_linux,syslog,local,">
  <rule id="100232" level="7">
    <program_name type="pcre2">^sudo$</program_name>
    <match type="pcre2">COMMAND=</match>
    <description>ED-01 Linux: sudo privileged command executed (audit record).</description>
    <group>privilege_use,linux_host_audit,</group>
    <mitre><id>T1548.003</id></mitre>
  </rule>
  <rule id="100233" level="10">
    <program_name type="pcre2">^(?:useradd|usermod|userdel|groupadd|groupmod|gpasswd)$</program_name>
    <match type="pcre2">(?i)(?:new user|new group|add|delete|remove|modify|change|password|group)</match>
    <description>ED-01 Linux: Local user or group administration event.</description>
    <group>account_change,linux_host_audit,</group>
    <mitre><id>T1098</id></mitre>
  </rule>
  <rule id="100234" level="10">
    <if_sid>5715</if_sid>
    <match type="pcre2">(?i)Accepted\s+\S+\s+for\s+root\s+from\s+</match>
    <description>ED-01 Linux: Successful direct SSH login to root account.</description>
    <group>privileged_login,linux_host_audit,</group>
    <mitre><id>T1078</id></mitre>
  </rule>
</group>

<!-- EX-06: 호스트 측 비인가 접근 지표; 방화벽/ZTNA 네트워크 정책은 Graylog에서 유지 -->
<group name="graylog_ex06_linux,syslog,local,">
  <rule id="100235" level="8">
    <program_name type="pcre2">^sshd$</program_name>
    <match type="pcre2">(?i)(?:Invalid user|User \S+ from \S+ not allowed because)</match>
    <description>EX-06 Linux: SSH request using invalid or disallowed account.</description>
    <group>unauthorized_host_access,authentication_failed,</group>
    <mitre><id>T1110</id></mitre>
  </rule>
</group>

<!-- Linux k3s/Flask: host-mounted application config and deployment paths.
     These do NOT cover overlay/ephemeral Pod files; collect them separately via CRI/PVC. -->
<group name="k3s_flask_linux,syscheck,local,">
  <rule id="100236" level="8">
    <if_sid>550,553,554</if_sid>
    <field name="file" type="pcre2">^/(?:opt/flask-app|srv/flask-app|etc/rancher/k3s)/</field>
    <description>Linux Flask deployment or k3s configuration file changed: $(file)</description>
    <group>configuration_change,linux_fim,</group>
    <mitre><id>T1565.001</id></mitre>
  </rule>
  <rule id="100237" level="11">
    <if_sid>553</if_sid>
    <field name="file" type="pcre2">^/(?:opt/flask-app|srv/flask-app|etc/rancher/k3s)/</field>
    <description>Linux Flask deployment or k3s configuration file deleted: $(file)</description>
    <group>configuration_deletion,linux_fim,</group>
    <mitre><id>T1070.004</id></mitre>
  </rule>
</group>
