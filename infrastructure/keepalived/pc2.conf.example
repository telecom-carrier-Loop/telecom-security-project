global_defs {
    router_id TELECOM_PC2
    script_user root
    enable_script_security
}
vrrp_script chk_edge {
    script "/etc/keepalived/check-edge.sh"
    interval 2
    timeout 2
    fall 3
    rise 2
    weight 0
}
vrrp_instance TELECOM_WEB {
    state BACKUP
    interface REPLACE_WITH_VLAN10_INTERFACE
    virtual_router_id 51
    priority 100
    advert_int 1
    unicast_src_ip 192.168.10.12
    unicast_peer { 192.168.10.11 }
    virtual_ipaddress { 192.168.10.100/24 }
    track_script { chk_edge }
}
