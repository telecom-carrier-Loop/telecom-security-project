[mysqld]
server_id=2
log_bin=mysql-bin
relay_log=relay-bin
gtid_mode=ON
enforce_gtid_consistency=ON
log_replica_updates=ON
read_only=ON
# The official image must finish first-time account initialization.
# mysql-lab.py sets PERSIST super_read_only=ON after that initialization.
sync_binlog=1
innodb_flush_log_at_trx_commit=1
